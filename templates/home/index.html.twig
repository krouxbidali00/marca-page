{% extends 'base.html.twig' %}

{% block title %}Marca-Page — votre bibliothèque, élégamment réunie{% endblock %}

{% block body %}
<header class="position-relative overflow-hidden">
    <div class="grain position-absolute top-0 start-0 end-0 bottom-0 opacity-75"></div>
    <div class="blob blob--a"></div>
    <div class="blob blob--b"></div>

    <div class="container position-relative py-5">
        <div class="row align-items-center g-5 pt-4 pt-lg-5 pb-5">
            <div class="col-lg-6">
                <span class="pill pill-rose mb-4"><i class="bi bi-stars"></i> Votre rayon, en ligne</span>
                <h1 class="font-serif display-3 fw-semibold lh-1 mb-4 ls-tight">Votre bibliothèque, <em class="fst-italic text-primary">élégamment</em> réunie.</h1>
                <p class="fs-5 text-mute mb-4 pe-lg-5 measure-md">Cataloguez vos livres depuis Google Books, suivez vos lectures et redécouvrez ce qui dort sur vos étagères. Un compagnon doux, sans bruit, pensé pour les lecteurs.</p>
                <div class="d-flex flex-wrap gap-3 mb-5">
                    <a href="{{ path('app_register') }}" class="btn btn-primary btn-lg rounded-pill px-4 fw-medium">Créer un compte <i class="bi bi-arrow-right ms-1"></i></a>
                    <a href="{{ path('app_login') }}" class="btn btn-outline-primary btn-lg rounded-pill px-4 fw-medium">Se connecter</a>
                </div>
                <div class="d-flex align-items-center gap-4 flex-wrap">
                    <div class="d-flex align-items-center gap-2 text-mute"><i class="bi bi-shield-lock fs-5 text-primary"></i><small>Vos données restent chez vous</small></div>
                    <div class="d-flex align-items-center gap-2 text-mute"><i class="bi bi-search fs-5 text-primary"></i><small>Métadonnées Google Books</small></div>
                    <div class="d-flex align-items-center gap-2 text-mute"><i class="bi bi-bell-slash fs-5 text-primary"></i><small>Aucune notification</small></div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="hero-stack">
                    <div class="cover hero-cover--1 cover--theme-0 float-a">
                        <span class="spine"></span><div class="deco"></div>
                        <div class="body">
                            <div class="author-c">Albert Camus</div>
                            <div><div class="title-c fs-3 mb-2">L'Étranger</div><div class="pub">Gallimard · 1942</div></div>
                        </div>
                    </div>
                    <div class="cover hero-cover--2 cover--theme-1 float-b">
                        <span class="spine"></span><div class="deco"></div>
                        <div class="body">
                            <div class="author-c">Antoine de Saint-Exupéry</div>
                            <div>
                                <div class="mb-2">
                                    <svg width="56" height="56" viewBox="0 0 60 60" fill="none"><circle cx="30" cy="30" r="14" fill="#FFE5B4"/><g stroke="#3A2A33" stroke-width="1.5"><line x1="30" y1="6" x2="30" y2="14"/><line x1="30" y1="46" x2="30" y2="54"/><line x1="6" y1="30" x2="14" y2="30"/><line x1="46" y1="30" x2="54" y2="30"/><line x1="12" y1="12" x2="18" y2="18"/><line x1="42" y1="42" x2="48" y2="48"/><line x1="48" y1="12" x2="42" y2="18"/><line x1="18" y1="42" x2="12" y2="48"/></g></svg>
                                </div>
                                <div class="title-c fs-2 mb-1">Le Petit<br>Prince</div><div class="pub">Conte · 1943</div>
                            </div>
                        </div>
                    </div>
                    <div class="cover hero-cover--3 cover--theme-2 float-c">
                        <span class="spine"></span><div class="deco"></div>
                        <div class="body">
                            <div class="author-c">Victor Hugo</div>
                            <div><div class="title-c fs-3 mb-2">Notre-Dame<br>de Paris</div><div class="pub">Roman · 1831</div></div>
                        </div>
                    </div>

                    <div class="hero-badge hero-badge--reading">
                        <span class="pill pill-peche"><i class="bi bi-book-half"></i> En cours</span>
                        <div>
                            <div class="fw-semibold small">Page 142 / 384</div>
                            <div class="progress hero-progress"><div class="progress-bar w-50"></div></div>
                        </div>
                    </div>

                    <div class="hero-badge hero-badge--rating">
                        {{ include('_partials/stars.html.twig', {value: 4, size_class: 'stars--sm'}) }}
                        <span class="fw-semibold ms-1">4.2</span><small class="text-mute">· 218 avis</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

<section class="border-top border-bottom bg-white">
    <div class="container py-4">
        <div class="row g-4 align-items-center text-center text-md-start">
            <div class="col-md-3"><div class="d-flex align-items-baseline gap-2 justify-content-center justify-content-md-start"><span class="font-serif fs-2 fw-semibold">∞</span><small class="text-mute">livres dans votre rayon</small></div></div>
            <div class="col-md-3"><div class="d-flex align-items-baseline gap-2 justify-content-center justify-content-md-start"><span class="font-serif fs-2 fw-semibold">0 €</span><small class="text-mute">et sans publicité</small></div></div>
            <div class="col-md-3"><div class="d-flex align-items-baseline gap-2 justify-content-center justify-content-md-start"><span class="font-serif fs-2 fw-semibold">100 %</span><small class="text-mute">de vos notes restent privées</small></div></div>
            <div class="col-md-3"><div class="d-flex align-items-baseline gap-2 justify-content-center justify-content-md-start"><span class="font-serif fs-2 fw-semibold">1</span><small class="text-mute">geste pour ajouter un livre</small></div></div>
        </div>
    </div>
</section>

<section id="decouvrir" class="section">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-8">
                <div class="eyebrow mb-3">Comment ça marche</div>
                <h2 class="font-serif display-5 fw-semibold mb-3 ls-tight">Trois gestes pour retrouver le plaisir de lire.</h2>
                <p class="text-mute fs-5 mb-0 measure-lg">Marca-Page est volontairement simple : je cherche, j'ajoute, je m'y retrouve. Pas de gamification, pas de notifications — juste ma bibliothèque, mieux rangée.</p>
            </div>
        </div>
        <div class="row g-4 g-lg-5">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4 p-lg-5">
                    <div class="step-num step-num--1 mb-4">01</div>
                    <h3 class="font-serif fs-3 fw-semibold mb-2">Cherchez, ajoutez</h3>
                    <p class="text-mute mb-4">Tapez un titre, un auteur ou un ISBN. La couverture, le résumé et les métadonnées viennent de Google Books, automatiquement.</p>
                    <div class="d-flex align-items-center gap-2 text-mute small"><i class="bi bi-search fs-5 text-primary"></i><span>Recherche Google Books</span></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4 p-lg-5">
                    <div class="step-num step-num--2 mb-4">02</div>
                    <h3 class="font-serif fs-3 fw-semibold mb-2">Suivez vos lectures</h3>
                    <p class="text-mute mb-4">À lire, en cours, terminé. Marquez les pages, ajoutez vos notes, gardez vos citations préférées.</p>
                    <div class="d-flex align-items-center gap-2 text-mute small"><i class="bi bi-bookmark-heart fs-5 text-primary"></i><span>Notes, citations, progression</span></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4 p-lg-5">
                    <div class="step-num step-num--3 mb-4">03</div>
                    <h3 class="font-serif fs-3 fw-semibold mb-2">Redécouvrez vos étagères</h3>
                    <p class="text-mute mb-4">Filtres, étagères thématiques, suggestions douces : votre bibliothèque devient enfin lisible.</p>
                    <div class="d-flex align-items-center gap-2 text-mute small"><i class="bi bi-grid-3x3-gap fs-5 text-primary"></i><span>Étagères, filtres, similaires</span></div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section pt-0">
    <div class="container">
        <div class="d-flex flex-wrap align-items-end justify-content-between mb-5 gap-3">
            <div>
                <div class="eyebrow mb-3">Quelques classiques</div>
                <h2 class="font-serif display-5 fw-semibold mb-0 ls-tight">De quoi commencer <em class="fst-italic text-primary">votre rayon</em>.</h2>
            </div>
            <a href="{{ path('app_login') }}" class="btn btn-link fw-medium">Ouvrir ma bibliothèque <i class="bi bi-arrow-right ms-1"></i></a>
        </div>

        <div class="scroll-row scroll-row--bleed d-flex gap-4 overflow-auto pb-3">
            {% set demo = [
                {title: "L'Étranger", author: 'Albert Camus', meta: 'Roman · 1942', theme: 0, rating: '4.6'},
                {title: 'Le Petit Prince', author: 'A. de Saint-Exupéry', meta: 'Conte · 1943', theme: 1, rating: '4.9'},
                {title: 'Notre-Dame de Paris', author: 'Victor Hugo', meta: 'Roman · 1831', theme: 2, rating: '4.4'},
                {title: 'Les Années', author: 'Annie Ernaux', meta: 'Récit · 2008', theme: 3, rating: '4.5'},
                {title: 'Du côté de chez Swann', author: 'Marcel Proust', meta: 'Roman · 1913', theme: 4, rating: '4.3'},
                {title: 'Le Deuxième Sexe', author: 'Simone de Beauvoir', meta: 'Essai · 1949', theme: 5, rating: '4.7'}
            ] %}
            {% for b in demo %}
                <a class="book-card carousel-card text-decoration-none text-ink" href="{{ path('app_register') }}">
                    <div class="cover cover--carousel cover--theme-{{ b.theme }} mb-3">
                        <span class="spine"></span><div class="deco"></div>
                        <div class="body"><div class="author-c">{{ b.author }}</div><div><div class="title-c mb-2">{{ b.title }}</div><div class="pub">{{ b.meta }}</div></div></div>
                    </div>
                    <div class="d-flex justify-content-between align-items-start">
                        <div><div class="font-serif fs-5 fw-semibold lh-sm">{{ b.title }}</div><small class="text-mute">{{ b.author }}</small></div>
                        <span class="stars stars--sm"><i class="bi bi-star-fill"></i><small class="ms-1 fw-semibold text-ink">{{ b.rating }}</small></span>
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>
</section>

<section id="tarifs" class="container pb-5">
    <div class="cta-card rounded-4 p-4 p-md-5 position-relative overflow-hidden">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <h2 class="font-serif display-5 fw-semibold mb-3 ls-tight">Votre bibliothèque vous attend.</h2>
                <p class="fs-5 text-mute mb-4 pe-lg-5 measure-md">Sans pub, sans algorithme, sans pression. Juste vos livres, là où vous les avez laissés.</p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="{{ path('app_register') }}" class="btn btn-primary btn-lg rounded-pill px-4 fw-medium">Créer mon compte</a>
                    <a href="{{ path('app_login') }}" class="btn btn-link fw-medium">Se connecter <i class="bi bi-arrow-right ms-1"></i></a>
                </div>
            </div>
            <div class="col-lg-5 text-center">
                <div class="d-inline-flex gap-3 align-items-end">
                    <div class="cover cover--sm cta-cover--1 cover--theme-0"><span class="spine"></span><div class="deco"></div><div class="body"><div class="author-c">A. Camus</div><div class="title-c">L'Étranger</div></div></div>
                    <div class="cover cover--sm cta-cover--2 cover--theme-1"><span class="spine"></span><div class="deco"></div><div class="body"><div class="author-c">Saint-Exupéry</div><div class="title-c">Le Petit Prince</div></div></div>
                    <div class="cover cover--sm cta-cover--3 cover--theme-2"><span class="spine"></span><div class="deco"></div><div class="body"><div class="author-c">V. Hugo</div><div class="title-c">Notre-Dame de Paris</div></div></div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
