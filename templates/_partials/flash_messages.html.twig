{% set flash_types = {'success': 'alert-success', 'danger': 'alert-danger', 'warning': 'alert-warning', 'info': 'alert-info', 'notice': 'alert-info'} %}
{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="container pt-3">
            <div class="alert {{ flash_types[type] ?? 'alert-secondary' }} alert-dismissible rounded-4 border-0 shadow-sm mb-0" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        </div>
    {% endfor %}
{% endfor %}
