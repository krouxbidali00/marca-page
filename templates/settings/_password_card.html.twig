<form method="post" action="{{ path('app_settings_password') }}" class="settings-card">
    <h2>Mot de passe</h2>
    <input type="hidden" name="_token" value="{{ csrf_token('settings_password') }}">

    <div class="mb-3" data-controller="password-toggle">
        <label class="form-label">Mot de passe actuel</label>
        <input class="form-control" type="password" name="currentPassword" required autocomplete="current-password"
               data-password-toggle-target="input">
    </div>

    <div class="mb-3" data-controller="password-strength">
        <label class="form-label">Nouveau mot de passe</label>
        <input class="form-control" type="password" name="newPassword" required minlength="8" autocomplete="new-password"
               data-password-strength-target="input"
               data-action="input->password-strength#evaluate">
        <div class="strength" data-password-strength-target="bar"><span></span><span></span><span></span><span></span></div>
        <div class="d-flex justify-content-between mt-2">
            <small class="text-mute">8 caractères minimum.</small>
            <small class="fw-medium text-mute" data-password-strength-target="label">—</small>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Confirmation</label>
        <input class="form-control" type="password" name="confirmPassword" required minlength="8" autocomplete="new-password">
    </div>

    <button type="submit" class="btn btn-primary rounded-pill">Changer le mot de passe</button>
</form>
