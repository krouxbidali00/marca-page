{# Params: query (string), results (GoogleBookResult[]), error (?string), ownedBookIds (map volumeId=>bookId) #}
{% if error %}
    <div class="alert alert-danger rounded-4 border-0">{{ error }}</div>
{% endif %}

{% if query == '' %}
    <p class="text-mute text-center py-5">Tapez quelque chose ci-dessus pour rechercher dans le catalogue Google Books.</p>
{% elseif results|length == 0 and not error %}
    <p class="text-mute text-center py-5">Aucun résultat pour « {{ query }} ».</p>
{% else %}
    <div class="d-flex flex-column gap-3">
        {% for result in results %}
            {% set theme = result.title|length % 12 %}
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="d-flex gap-3 align-items-center flex-wrap flex-md-nowrap">
                    {% if result.thumbnailUrl %}
                        <div class="cover cover--xs"><span class="spine"></span><img class="cover-img" src="{{ result.thumbnailUrl }}" alt="Couverture de {{ result.title }}" loading="lazy"></div>
                    {% else %}
                        <div class="cover cover--xs cover--theme-{{ theme }}"><span class="spine"></span><div class="deco"></div><div class="body"><div class="author-c">{{ result.authors|first|default('') }}</div><div class="title-c">{{ result.title }}</div></div></div>
                    {% endif %}
                    <div class="flex-grow-1">
                        <div class="font-serif fs-5 fw-semibold lh-sm">{{ result.title }}</div>
                        {% if result.subtitle %}<div class="text-mute small fst-italic">{{ result.subtitle }}</div>{% endif %}
                        <div class="text-mute small mb-1">{{ result.authorsLine }}{% if result.publisher %} · {{ result.publisher }}{% endif %}{% if result.publishedYear %} · {{ result.publishedYear }}{% endif %}{% if result.pageCount %} · {{ result.pageCount }} p.{% endif %}</div>
                        {% if result.description %}{% set desc = result.description|striptags %}<p class="text-mute small mb-0">{{ desc|length > 180 ? desc|slice(0, 180) ~ '…' : desc }}</p>{% endif %}
                    </div>
                    {% set ownedId = ownedBookIds[result.volumeId]|default(0) %}
                    <div class="flex-shrink-0 d-flex gap-2 align-items-center"
                         data-controller="library-toggle"
                         data-library-toggle-import-url-value="{{ path('app_book_import') }}"
                         data-library-toggle-import-token-value="{{ csrf_token('import_book') }}"
                         data-library-toggle-volume-id-value="{{ result.volumeId }}"
                         data-library-toggle-query-value="{{ query }}"
                         data-library-toggle-delete-url-template-value="{{ path('app_book_delete', {id: 0}) }}"
                         data-library-toggle-book-id-value="{{ ownedId }}"
                         data-library-toggle-delete-token-value="{{ ownedId ? csrf_token('delete_book_' ~ ownedId) : '' }}">
                        <button type="button" class="btn btn-primary rounded-pill px-3 text-nowrap{{ ownedId ? ' d-none' : '' }}"
                                data-library-toggle-target="add" data-action="library-toggle#add">
                            <i class="bi bi-plus-lg me-1"></i> Ajouter
                        </button>
                        <span class="btn btn-success rounded-pill px-3 text-nowrap{{ ownedId ? '' : ' d-none' }}" aria-disabled="true"
                              data-library-toggle-target="ownedBadge">
                            <i class="bi bi-check-lg me-1"></i> Déjà ajouté
                        </span>
                        <button type="button" class="btn btn-outline-danger rounded-pill px-3 text-nowrap{{ ownedId ? '' : ' d-none' }}"
                                data-library-toggle-target="remove" data-action="library-toggle#remove">
                            <i class="bi bi-trash me-1"></i> Retirer
                        </button>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
