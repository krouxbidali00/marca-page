{# Params: page (App\Pagination\Page of Book) #}
{% if page.isEmpty %}
    <div class="card border-0 shadow-sm rounded-4 text-center p-5">
        <div class="font-serif fs-3 fw-semibold mb-2">Rien ici… pour l'instant</div>
        <p class="text-mute mb-4">Cherchez un titre sur Google Books et ajoutez-le à votre bibliothèque.</p>
        <div><a href="{{ path('app_book_search') }}" class="btn btn-primary rounded-pill px-4"><i class="bi bi-plus-lg me-1"></i> Ajouter un livre</a></div>
    </div>
{% else %}
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-3 row-cols-xl-4 g-3 g-md-4" data-library-target="grid">
        {% for book in page.items %}
            <div class="col">{{ include('_partials/book_card.html.twig', {book: book}) }}</div>
        {% endfor %}
    </div>
{% endif %}
