{% extends 'base.html.twig' %}

{% block title %}Ma bibliothèque · Marca-Page{% endblock %}
{% block navbar %}{% include '_partials/navbar_app.html.twig' %}{% endblock %}
{% block footer %}{% include '_partials/footer_compact.html.twig' %}{% endblock %}

{% set sort_labels = {recent: 'Récemment ajoutés', title_asc: 'Alphabétique (A → Z)', author: 'Par auteur', rating: 'Ma note', published: 'Date de parution'} %}

{% block body %}
<div data-controller="library title-edit"
     data-library-url-value="{{ path('app_library') }}"
     data-library-initial-sort-value="{{ filter.sort }}">

    <header class="position-relative overflow-hidden">
        <div class="blob page-blob--1"></div>
        <div class="blob page-blob--2"></div>
        <div class="container py-5 position-relative">
            <div class="text-center mb-4">
                <small class="eyebrow">Ma bibliothèque</small>
                <h1 class="font-serif display-4 fw-semibold mt-2 mb-3">{{ totalInLibrary }} livre{{ totalInLibrary > 1 ? 's' }}, <em class="fst-italic text-primary">soigneusement rangé{{ totalInLibrary > 1 ? 's' }}</em>.</h1>
                <p class="text-mute fs-5 mb-4">Cherchez un titre, un auteur, un genre — ou parcourez vos étagères.</p>
            </div>
            <form method="get" action="{{ path('app_library') }}" class="search-wrap"
                  data-action="submit->library#submitSearch">
                {% if filter.sort != 'recent' %}<input type="hidden" name="sort" value="{{ filter.sort }}">{% endif %}
                <i class="bi bi-search"></i>
                <input type="search" name="q" class="search-input" placeholder="Chercher dans ma bibliothèque…" value="{{ filter.query }}"
                       data-library-target="search"
                       data-action="input->library#searchInput">
                <kbd>↵</kbd>
            </form>
        </div>
    </header>

    <main class="container pb-5">
        <div class="row g-4">

            <aside class="col-lg-3 d-none d-lg-block">
                <div class="filter-sticky">
                    <div class="filter-card">
                        {{ include('library/_filters.html.twig') }}
                    </div>
                </div>
            </aside>

            <section class="col-lg-9">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <button class="btn btn-soft rounded-pill d-lg-none" data-bs-toggle="offcanvas" data-bs-target="#filtersMobile"><i class="bi bi-sliders"></i> Filtres</button>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <div class="view-toggle">
                            <button type="button" data-library-target="viewButton" data-view="grid" data-action="library#setView" class="active" aria-label="Vue grille"><i class="bi bi-grid-fill"></i></button>
                            <button type="button" data-library-target="viewButton" data-view="list" data-action="library#setView" aria-label="Vue liste"><i class="bi bi-list-ul"></i></button>
                        </div>
                        <div class="dropdown">
                            <button class="sort-btn dropdown-toggle d-inline-flex align-items-center gap-2" data-bs-toggle="dropdown"><i class="bi bi-sort-down"></i> Trier : <strong data-library-target="sortLabel">{{ sort_labels[filter.sort] }}</strong></button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm rounded-4 border-0 p-2">
                                {% for value, label in sort_labels %}
                                    <li><a class="dropdown-item rounded-3 py-2 {{ filter.sort == value ? 'active' }}"
                                           data-library-target="sortItem"
                                           data-sort="{{ value }}"
                                           data-sort-label="{{ label }}"
                                           data-action="library#selectSort"
                                           href="{{ path('app_library', filter.toQueryParams|filter((v, k) => k != 'sort')|merge(value == 'recent' ? {} : {sort: value})) }}">{{ label }}</a></li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </div>

                <div data-library-target="results">
                    {{ include('library/_results.html.twig') }}
                </div>
            </section>
        </div>
    </main>

    <div class="offcanvas offcanvas-start" tabindex="-1" id="filtersMobile">
        <div class="offcanvas-header border-bottom">
            <h5 class="offcanvas-title font-serif fw-semibold">Filtres</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
        </div>
        <div class="offcanvas-body">
            {{ include('library/_filters.html.twig') }}
        </div>
    </div>

    {{ include('library/_title_edit_modal.html.twig') }}
</div>
{% endblock %}
